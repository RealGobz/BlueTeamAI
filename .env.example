# ==============================================================================
# BlueTeamAI Environment Configuration
# ==============================================================================
# Copy this file to .env and populate your credentials:
#   cp .env.example .env
#
# If using setup/setup.ps1 or setup.sh with Azure CLI logged in,
# PROJECT_ENDPOINT and LLM_DEPLOYMENT_NAME will be configured automatically.
# ==============================================================================

# --- Azure AI Foundry Configuration ---
# Direct endpoint URL of your Azure AI Foundry project workspace
PROJECT_ENDPOINT=https://<your-hub-name>-aiservices.services.ai.azure.com/api/projects/<your-project-name>

# Name of the model deployment in Azure AI Foundry (e.g. agent_llm, gpt-4o, claude-3-5-sonnet)
LLM_DEPLOYMENT_NAME=agent_llm

# --- External Threat Intelligence (Optional) ---
# VirusTotal API Key for global hash reputation lookups (get free key at virustotal.com)
VT_API_KEY=

# Exa AI Search API Key for web threat intelligence lookups (get key at exa.ai)
EXAAI_SEARCH_API_KEY=

# --- Human-In-The-Loop & UI Settings ---
# HITL Mode: "web" (default) routes containment/question prompts to web server, "auto" auto-approves for headless testing
HITL_MODE=web
HITL_PORT=8765
UI_MAIN_PORT=8766

# Dry run mode: "true" skips destructive process kill and quarantine on disk
DRY_RUN=false
